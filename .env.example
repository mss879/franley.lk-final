# =============================================================================
# Franley — environment variables
#
# Copy this file to `.env.local` for local development, and set the same
# variables on your host (Vercel: Project → Settings → Environment Variables)
# for production. `.env.local` is gitignored; this template is not.
#
# The site boots with NONE of these set — it serves the bundled seed catalogue
# so you always have something to look at. What you lose without them is live
# data, the admin panel, and order emails. Missing variables are listed in the
# server log at startup.
#
# Full launch walkthrough: DEPLOY.md
# =============================================================================


# ---- Supabase ---------------------------------------------------------------
# Supabase dashboard → Project Settings → API

# Your project URL.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# The "anon public" key. Safe in the browser — the database's row-level
# security decides what it is allowed to see.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# The "service_role" key. SERVER ONLY.
#
# This key ignores every security rule in the database. Never put it in a
# variable whose name starts with NEXT_PUBLIC_, never paste it into a web page,
# never send it over WhatsApp or email. If it ever leaks, reset it immediately
# in Project Settings → API.
#
# REQUIRED once the store is live: checkout places every order with it (the
# database accepts orders from the server only), and it sends the order
# confirmation emails, records PayHere card payments (without it a card order
# is charged but never marked paid) and makes refunds from the admin.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key


# ---- Site -------------------------------------------------------------------
# http://localhost:3000 locally, https://franley.lk in production.
#
# Canonical URLs, the sitemap, all structured data and every link inside an
# order email are built from this. Getting it wrong in production is both an
# SEO bug and a broken-link bug in customer email.
NEXT_PUBLIC_SITE_URL=http://localhost:3000


# ---- Email (Resend) ---------------------------------------------------------
# resend.com → API Keys. Create the key with "Sending access" only.
#
# Before this works you must add franley.lk under Resend → Domains and add the
# three DNS records it gives you (MX, plus DKIM and SPF TXT records) at your
# registrar. Sending from an unverified domain puts order confirmations in
# spam, and customers conclude the order failed.
#
# Leave these unset and checkout still works — no email is sent, and the admin
# order page says so.
RESEND_API_KEY=re_your_api_key

# Must be on the domain you verified in Resend.
RESEND_FROM_EMAIL=Franley <orders@franley.lk>

# Where a customer's reply lands.
RESEND_REPLY_TO=support@franley.lk

# Who gets the "new order" alert. Comma-separate for more than one address.
ORDER_NOTIFICATION_EMAIL=support@franley.lk


# ---- Card payments (PayHere) ------------------------------------------------
# payhere.lk → sign in → side menu → Integrations.
#
# Leave the ID and secret unset and checkout simply does not offer "Pay online"
# — cash on delivery and bank transfer keep working.
#
# PayHere has two completely separate systems, each with its own account and
# its own keys:
#   sandbox  https://sandbox.payhere.lk  — test cards, no real money
#   live     https://www.payhere.lk      — real money
# Keys from one never work on the other.

# Shown at the top of the Integrations page. Digits only.
PAYHERE_MERCHANT_ID=

# SERVER ONLY — this is what signs every payment request and proves that a
# "payment received" message really came from PayHere. Never give it a
# NEXT_PUBLIC_ name.
#
# Integrations → Add Domain/App → enter the domain (franley.lk for live;
# localhost works in the sandbox) → wait for approval (up to 24 hours on live)
# → copy the Merchant Secret shown against that domain. The secret is tied to
# the domain: a new domain means a new secret.
PAYHERE_MERCHANT_SECRET=

# "sandbox" or "live". Anything other than exactly "live" is treated as
# sandbox, so a half-finished setup can never charge a real card.
# Production: live, with NEXT_PUBLIC_SITE_URL=https://franley.lk and
# PAYHERE_NOTIFY_URL unset. Full go-live checklist: DEPLOY.md §2b.
PAYHERE_MODE=sandbox

# Optional but recommended — lets the store ASK PayHere whether an order was
# paid instead of only waiting to be told, and lets the admin refund a card
# payment with one button. It is also the only way a payment gets recorded on
# localhost, which PayHere's servers cannot reach.
#
# PayHere → Settings → API Keys → Create API Key → tick "Automated Charging
# API" → View Credentials. In the sandbox set the allowed domain to *.
# On live, PayHere must also whitelist your server's IP address — email
# support@payhere.lk with it. Vercel has no fixed outbound IP by default; until
# you have one, PayHere refuses these calls and the store carries on without
# them (payments are still recorded from PayHere's notification).
PAYHERE_APP_ID=
PAYHERE_APP_SECRET=

# Optional, local testing only. PayHere posts the payment result to
# <NEXT_PUBLIC_SITE_URL>/api/payments/payhere/notify, which has to be reachable
# from the internet. To test that on your own machine, run a tunnel
# (e.g. `ngrok http 3000`) and put its URL here:
#   PAYHERE_NOTIFY_URL=https://abc123.ngrok.app/api/payments/payhere/notify
# Never set this in production.
PAYHERE_NOTIFY_URL=
